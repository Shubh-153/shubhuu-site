# Notion integration token (one token, shared with every database below)
NOTION_API_KEY=

# One database ID per content type. A generator with no ID is skipped, so you
# can wire these up one at a time.
NOTION_DATABASE_ID=             # Blog posts
NOTION_PROJECTS_DB_ID=          # Projects
NOTION_ACADEMICS_DB_ID=         # Education
NOTION_ACHIEVEMENTS_DB_ID=      # Certifications & awards

# Cloudinary — powers the creative gallery (fetch-bento.js)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
